{
  "name": "resize-cheminfo-org",
  "version": "0.0.0",
  "description": "Drop images or folders, crop, rotate, adjust colours, resize and compress them to JPEG or PNG, in the browser.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run test && npm run test-e2e && npm run build-only",
    "build-only": "vite build && npm run check-seo",
    "check-deploy": "node node_modules/react-cheminfo/bin/check-deploy.mjs --image-name=ghcr.io/cheminfo/resize.cheminfo.org",
    "check-seo": "node node_modules/react-cheminfo/bin/check-seo.mjs dist",
    "check-tokens": "node node_modules/react-cheminfo/bin/check-tokens.mjs src",
    "check-types": "tsc --noEmit",
    "dev": "vite",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "og-image": "node scripts/generateOgImage.ts",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "preview": "vite preview",
    "test": "npm run test-only && npm run check-types && npm run check-tokens && npm run check-deploy && npm run eslint && npm run prettier",
    "test-e2e": "playwright test",
    "test-only": "vitest run --coverage"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.23.2",
    "@blueprintjs/icons": "^6.17.0",
    "@blueprintjs/select": "^6.4.4",
    "@preact/signals-react": "^3.12.0",
    "@zip.js/zip.js": "^2.25.0",
    "fifo-logger": "^2.0.1",
    "file-collection": "^6.7.0",
    "react": "^19.3.1",
    "react-cheminfo": "^0.147.0",
    "react-dom": "^19.3.1",
    "react-roi": "^3.2.1",
    "react-science": "^24.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@zakodium/tsconfig": "^1.0.5",
    "eslint": "^9.39.5",
    "eslint-config-zakodium": "^20.1.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0"
  }
}
